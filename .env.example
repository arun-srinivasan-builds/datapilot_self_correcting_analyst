# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-6-luna
MAX_AGENT_MESSAGES=12
SANDBOX_URL=http://127.0.0.1:8765
SANDBOX_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Optional model parameters (leave blank to not send). Do not set temperature: gpt-6-luna only accepts the default.
OPENAI_SEED=
MAX_COMPLETION_TOKENS=
# Optional pricing, USD per 1M tokens. Blank => "Pricing not configured".
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=

# Live-run limits. The 12-agent-message cap always applies in addition.
# Total model tokens (input+output, all calls) per run; the run stops as UNAPPROVED when exceeded.
MAX_RUN_TOKENS=30000
# Wall-clock limit per run in seconds.
RUN_TIMEOUT_SECONDS=300

# Sandbox broker (loopback only). Token: >=24 random characters, shared by app and broker.
SANDBOX_TOKEN=
SANDBOX_BIND_HOST=127.0.0.1
SANDBOX_PORT=8765
SANDBOX_ROOT=.sandbox

# Test/diagnostic only. Fault injection is OFF unless APP_ENV is test or diagnostic AND FAULT_INJECTION
# names a known fault (missing_column | bad_column_lookup | hang). Never set these for normal use.
# APP_ENV=production
# FAULT_INJECTION=
