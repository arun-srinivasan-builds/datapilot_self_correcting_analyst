# DataPilot sandbox broker (host service). Creates one throw-away, network-less container per
# execution through the local Docker daemon. Listens ONLY on a group-restricted Unix socket.
#
# Install (needs approval; see docs/DEPLOY.md):  cp to /etc/systemd/system/ && systemctl daemon-reload
[Unit]
Description=DataPilot sandbox broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=dpsandbox
Group=dpsandbox
# the broker talks to the Docker daemon through this group (root-equivalent: see docs/DEPLOY.md)
SupplementaryGroups=docker
WorkingDirectory=/srv/datapilot/app
EnvironmentFile=/etc/datapilot/broker.env
ExecStart=/usr/bin/python3 -m sandbox_service.broker
Restart=on-failure
RestartSec=5

# /run/datapilot-sandbox is created owned by dpsandbox:dpsandbox, mode 0750; the socket is 0660
RuntimeDirectory=datapilot-sandbox
RuntimeDirectoryMode=0750

# Hardening that does not interfere with talking to Docker
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/datapilot/sandbox-root
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
