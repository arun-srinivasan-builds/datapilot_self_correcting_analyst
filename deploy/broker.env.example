# /etc/datapilot/broker.env  (root:dpsandbox, mode 0640). Never committed with real values.
# Same SANDBOX_TOKEN as in the app's .env (24+ random characters).
SANDBOX_TOKEN=CHANGE_ME_24_PLUS_RANDOM_CHARACTERS
SANDBOX_SOCKET=/run/datapilot-sandbox/broker.sock
SANDBOX_SOCKET_GROUP=dpsandbox
SANDBOX_ROOT=/srv/datapilot/sandbox-root
SANDBOX_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=25
# Set only if the image id on this host differs from sandbox_service/image/image.lock.json
# (see docs/DEPLOY.md step 5):
# SANDBOX_IMAGE_LOCK=/etc/datapilot/image.lock.json
